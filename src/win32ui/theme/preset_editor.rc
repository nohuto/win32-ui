WIN32UI_THEME_PRESETS DIALOGEX 0, 0, 332, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", 2101, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | LVS_NOSORTHEADER | WS_CLIPSIBLINGS | WS_TABSTOP, 14, 17, 112, 98
    PUSHBUTTON      "", 2103, 14, 119, 54, 11
    PUSHBUTTON      "", 2104, 72, 119, 54, 11
    PUSHBUTTON      "", 2105, 14, 133, 54, 11
    PUSHBUTTON      "", 2106, 72, 133, 54, 11
    PUSHBUTTON      "", 2107, 14, 147, 54, 11
    PUSHBUTTON      "", 2108, 72, 147, 54, 11

    CONTROL         "", 2102, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_CLIPSIBLINGS | WS_TABSTOP, 144, 17, 174, 97
    PUSHBUTTON      "", 2109, 144, 118, 64, 11
    AUTOCHECKBOX    "", 2110, 214, 119, 104, 10

    COMBOBOX        2111, 144, 148, 104, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
