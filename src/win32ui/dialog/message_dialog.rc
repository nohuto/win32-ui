

#include <windows.h>

WIN32UI_MESSAGE DIALOGEX 0, 0, 260, 60
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", 2004, "Static", SS_ICON | SS_REALSIZECONTROL | NOT WS_VISIBLE, 7, 7, 21, 20
    LTEXT           "", 2001, 7, 7, 246, 8, SS_NOPREFIX
    PUSHBUTTON      "", 2003, 7, 39, 50, 14, NOT WS_VISIBLE
END

WIN32UI_ABOUT DIALOGEX 0, 0, 260, 60
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON   "", IDOK, 203, 39, 50, 14
END
