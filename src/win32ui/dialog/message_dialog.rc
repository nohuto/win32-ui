

#include <windows.h>

WIN32UI_MESSAGE DIALOGEX 0, 0, 260, 60
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", 2004, "Static", SS_ICON | SS_REALSIZECONTROL | NOT WS_VISIBLE, 7, 7, 21, 20
    LTEXT           "", 2001, 7, 7, 246, 8, SS_NOPREFIX
    PUSHBUTTON      "", 2003, 7, 39, 50, 14, NOT WS_VISIBLE
END

WIN32UI_ABOUT DIALOGEX 0, 0, 260, 60
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON   "", IDOK, 203, 39, 50, 14
END

WIN32UI_TEXT_PROMPT DIALOGEX 0, 0, 220, 60
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
END

WIN32UI_TABLES DIALOGEX 0, 0, 260, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        2301, 8, 4, 244, 11, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    PUSHBUTTON      "", 2302, 8, 72, 64, 11
    PUSHBUTTON      "", IDOK, 167, 72, 40, 11
    DEFPUSHBUTTON   "", IDCANCEL, 212, 72, 40, 11
END

WIN32UI_CHECK_LIST DIALOGEX 0, 0, 561, 161
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON      "", 2401, 7, 143, 57, 11
    PUSHBUTTON      "", 2402, 70, 143, 51, 11
    DEFPUSHBUTTON   "", IDOK, 466, 143, 40, 11
    PUSHBUTTON      "", IDCANCEL, 512, 143, 40, 11
END
